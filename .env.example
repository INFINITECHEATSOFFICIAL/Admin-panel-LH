# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Admin auth ──────────────────────────────────────────
# The bootstrap admin is created on first run using these values,
# then the password hash lives only in the database — change the
# password from the panel afterward and rotate this value too.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now_please
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=8h

# ── API ─────────────────────────────────────────────────
# Sent by the Android app as `X-API-Key` on every request to
# /api/public/*. Rotate any time from Settings > API in the panel.
PUBLIC_API_KEY=replace_with_a_long_random_string

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the admin API
# (the browser panel origin). The Android app doesn't send an
# Origin header so it isn't affected by this.
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────
DB_PATH=./data/learning_hub.db
